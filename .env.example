# Copy to .env and edit. Everything has a working default except the tokens.

FASTRAG_ENV=prod
# Operator token: full admin over all tenants. Generate with: openssl rand -hex 32
FASTRAG_ADMIN_TOKEN=change-me-admin
POSTGRES_PASSWORD=change-me-db

# Bind the API to localhost by default. fastRag must stay on a private network (D9).
# FASTRAG_API_BIND=10.0.0.5

# Embeddings: BGE-M3 via the bundled TEI container. Changing the model means a full re-index.
FASTRAG_EMBEDDING_PROVIDER=tei
FASTRAG_EMBEDDING_MODEL=BAAI/bge-m3
FASTRAG_EMBEDDING_DIM=1024
# Hosted alternative with the same model (OpenAI-compatible API):
# FASTRAG_EMBEDDING_PROVIDER=openai
# FASTRAG_EMBEDDING_URL=https://api.deepinfra.com/v1/openai
# FASTRAG_EMBEDDING_API_KEY=...

# Reranker: bundled TEI container (CPU, slow), or hosted for the 300 ms target.
FASTRAG_RERANKER_PROVIDER=tei
FASTRAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
FASTRAG_RERANKER_TIMEOUT_S=2.0
# FASTRAG_RERANKER_PROVIDER=cohere
# FASTRAG_RERANKER_MODEL=rerank-v3.5
# FASTRAG_RERANKER_API_KEY=...

# Optional LLM for contextual chunk summaries at ingestion (OpenAI-compatible).
# FASTRAG_LLM_URL=http://litellm:4000
# FASTRAG_LLM_MODEL=gpt-4o-mini
# FASTRAG_LLM_API_KEY=...
# Optional prices (USD per million tokens), used only for `fastrag import --dry-run` estimates.
# FASTRAG_LLM_INPUT_COST_PER_MTOK=0.15
# FASTRAG_LLM_OUTPUT_COST_PER_MTOK=0.6
# More providers by name; a documents collection picks one with settings.ingest.context.llm.
# The key is read from the variable named in api_key_env.
# FASTRAG_LLM_PROVIDERS={"cheap": {"url": "http://litellm:4000", "model": "gpt-4o-mini", "api_key_env": "CHEAP_LLM_KEY"}}
# CHEAP_LLM_KEY=...

# Optional OCR for scanned PDFs with a vision model (OpenAI-compatible).
# FASTRAG_OCR_PROVIDER=vlm
# FASTRAG_OCR_URL=...
# FASTRAG_OCR_MODEL=...

# Google Drive / Sheets connector: mount the service-account JSON and point to it.
# FASTRAG_GOOGLE_CREDENTIALS_FILE=/data/sources/google-sa.json

FASTRAG_LOG_LEVEL=INFO
FASTRAG_SEARCH_LOG_RETENTION_DAYS=90
