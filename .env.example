# Copy to .env and adjust. Every setting is documented in docs/operations.md.

# "production" refuses to start with an unsafe configuration.
FASTRAG_ENVIRONMENT=development

# Storage
FASTRAG_DATABASE_PATH=.fastrag/fastrag.db
# Several replicas: keep documents, vectors and keyword search in Postgres + pgvector
# instead (pip install 'fastrag[postgres]'). Overrides FASTRAG_DATABASE_PATH.
# FASTRAG_POSTGRES_DSN=postgresql://fastrag:password@db.internal:5432/fastrag
FASTRAG_EMBEDDER=hashing            # or st:all-MiniLM-L6-v2 (pip install 'fastrag[st]')

# Generation: "extractive" works offline; "claude" needs ANTHROPIC_API_KEY
FASTRAG_GENERATOR=extractive
FASTRAG_CLAUDE_MODEL=claude-opus-5-5
FASTRAG_CLAUDE_EFFORT=medium

# Authentication
FASTRAG_API_KEYS_FILE=.fastrag/api_keys.json
# Sign-in through your identity provider (OIDC). All three are required together:
# FASTRAG_OIDC_JWKS_URL=https://idp.example.com/.well-known/jwks.json
# FASTRAG_JWT_ISSUER=https://idp.example.com/
# FASTRAG_JWT_AUDIENCE=fastrag
# Claim names, if your provider differs:
# FASTRAG_TOKEN_TENANT_CLAIM=tenant
# FASTRAG_TOKEN_GROUPS_CLAIM=groups
# FASTRAG_TOKEN_ROLES_CLAIM=roles
# Shared-secret (HS256) tokens, for local testing. Use a random value of 32+ characters:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# FASTRAG_JWT_SECRET=

# Governance and operations
FASTRAG_AUDIT_LOG_PATH=.fastrag/audit.jsonl
FASTRAG_REDACT_PII=true
FASTRAG_REDACT_QUESTIONS=true
# Several replicas: share rate limits and the answer cache (pip install 'fastrag[redis]').
# FASTRAG_REDIS_URL=rediss://:password@redis.internal:6380/0
# Optional reranker over the top candidates (pip install 'fastrag[st]').
# FASTRAG_RERANKER=cross-encoder
FASTRAG_RATE_LIMIT_PER_MINUTE=120        # per tenant
FASTRAG_RATE_LIMIT_BURST=30
FASTRAG_USER_RATE_LIMIT_PER_MINUTE=60    # per user, inside the tenant budget
FASTRAG_USER_RATE_LIMIT_BURST=15
FASTRAG_AUTH_FAILURES_PER_MINUTE=30      # failed logins per client address
FASTRAG_AUTH_FAILURE_BURST=10
FASTRAG_LOG_LEVEL=INFO
